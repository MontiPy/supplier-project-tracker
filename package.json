{
  "name": "supplier-tracking",
  "version": "1.0.0",
  "description": "Supplier-Project-Activity Tracking Desktop Application",
  "main": "dist-electron/main.js",
  "type": "module",
    "scripts": {
      "dev": "vite",
      "build": "tsc && vite build && tsc -p tsconfig.electron.json",
      "preview": "vite preview",
      "electron:dev": "vite",
      "electron:build": "npm run build && electron-builder",
      "type-check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
      "lint": "eslint src electron --ext .ts,.tsx",
      "rebuild": "npm rebuild better-sqlite3 --build-from-source"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "supplier-tracking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  }
}
